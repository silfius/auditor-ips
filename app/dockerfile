FROM python:3.12-slim

# Herramientas del sistema necesarias para:
# - escaneo de red (nmap, ping, arping)
# - detección de interfaces (iproute2 -> ip -j addr)
# - TLS y VAPID (openssl)
# - integración SSH con router (openssh-client)
RUN apt-get update     && apt-get install -y --no-install-recommends         tree         nmap         iputils-ping         iputils-arping         iputils-tracepath         traceroute         mtr-tiny         openssl         openssh-client         iproute2     && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt

COPY . .

RUN chmod +x /app/entrypoint.sh

# Con network_mode: host, el puerto real lo decide entrypoint.sh leyendo PORT.
# No usamos EXPOSE para no duplicar la fuente de verdad del puerto.
ENTRYPOINT ["/app/entrypoint.sh"]
