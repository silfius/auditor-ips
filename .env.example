# Auditor IPs — configuración local de ejemplo
# El asistente genera .env. No publiques el fichero real.

# Identidad y puerto
AUDITOR_CONTAINER_NAME=auditor_ips
AUDITOR_INSTANCE_ID=
SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=strict
PORT=9909

# Persistencia
DB_PATH=/data/auditor.db
DATA_DIR=./data
EXPORTS_HOST_DIR=./exports
BACKUPS_HOST_DIR=./data/backups
DIAGNOSTICS_HOST_DIR=./diagnostics

# TLS y acceso LAN
TLS_CERT_IP=
TLS_CERT_DNS=auditips.local
SERVER_IP=

# Red principal
NETWORK_INTERFACE=
SCAN_CIDR=192.168.1.0/24

# DNS opcionales para Docker, separados por coma
DOCKER_DNS=
DOCKER_DNS_SEARCH=

# Sesiones y retención
SESSION_TTL_HOURS=8
SCAN_RETENTION_DAYS=14

# Perfil registrado por el instalador
INSTALLATION_PROFILE=recommended

# Notificaciones opcionales
DISCORD_WEBHOOK_URL=
NOTIFY_NEW=1
NOTIFY_ONLINE=0
NOTIFY_OFFLINE=0
NOTIFY_MAC_CHANGE=0

# IPs que no se registran en audit log, separadas por coma
# AUDIT_SKIP_IPS=127.0.0.1,192.168.1.50

# Plataforma y capacidad de descubrimiento
PLATFORM_PROFILE=linux_native
DISCOVERY_MODE=full
