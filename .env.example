# Auditor IPs - ejemplo de configuración pública
# Copia este fichero como .env y ajusta los valores antes de arrancar.

# Puerto web expuesto por la aplicación.
PORT=9909

# Identificador único por instalación y cookie de sesión.
AUDITOR_CONTAINER_NAME=auditor_ips
AUDITOR_INSTANCE_ID=
SESSION_COOKIE_NAME=
SESSION_COOKIE_SECURE=1
SESSION_COOKIE_SAMESITE=strict

# Ruta interna de la base de datos dentro del contenedor.
DB_PATH=/data/auditor.db

# Ruta local persistente. Puedes usar una ruta relativa junto al repositorio.
DATA_DIR=./data
EXPORTS_HOST_DIR=./exports

# TLS local.
# Añade aquí la IP o DNS por el que accederás a la aplicación.
TLS_CERT_IP=
TLS_CERT_DNS=auditips.local
SERVER_IP=

# Red principal que quieres auditar.
# Ejemplo documental seguro.
SCAN_CIDR=192.168.1.0/24

# DNS opcionales para Docker. Separar múltiples valores por coma.
# El instalador puede detectarlas del host y excluir loopback/stub como 127.0.0.53.
DOCKER_DNS=
DOCKER_DNS_SEARCH=

# Autenticación.
# Recomendado: generar un hash PBKDF2 antes de exponer la aplicación en LAN.
# Si ADMIN_PASSWORD_HASH queda vacío, revisa la documentación antes de usar en producción.
ADMIN_PASSWORD_HASH=
SESSION_TTL_HOURS=8

# Notificaciones.
DISCORD_WEBHOOK_URL=
NOTIFY_NEW=1
NOTIFY_ONLINE=0
NOTIFY_OFFLINE=0
NOTIFY_MAC_CHANGE=0

# Retención básica.
SCAN_RETENTION_DAYS=14

# Directorios opcionales para integración con automatizaciones.
# Déjalos vacíos si no usas estados externos de scripts.
SCRIPTS_STATUS_HOST_DIR=
SCRIPTS_PROMPTS_HOST_DIR=
